# ===================================================
# ANUVAD Environment Configuration
# ===================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Whisper Model Configuration
# Options: tiny, base, small, medium, large-v3
# Recommendation: 'tiny' for fastest CPU response, 'base' for better accuracy on CPU
WHISPER_MODEL=tiny

# Execution Device
# Options: auto, cpu, cuda
DEVICE=auto

# Compute Type
# Options: auto, int8, float16
# 'int8' is recommended for CPU, 'float16' for NVIDIA CUDA GPU
COMPUTE_TYPE=auto

# Audio Processing
SAMPLING_RATE=16000
MIN_CHUNK_SIZE=0.3
ENABLE_VAD=true
VAD_THRESHOLD=0.5

# Translation Settings
ENABLE_TRANSLATION=true
# Options: auto (Google Web with MyMemory fallback), mymemory, google
TRANSLATION_ENGINE=auto
DEFAULT_SOURCE_LANGUAGE=en
DEFAULT_TARGET_LANGUAGE=es

# Optional: Official Google Cloud Translation API Key (leave empty for free web/MyMemory engines)
GOOGLE_TRANSLATE_API_KEY=
