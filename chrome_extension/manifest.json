{
  "name": "Anuvad - Multilingual Speech Captioning",
  "description": "Real-time browser tab audio captioning and translation powered by local Anuvad backend.",
  "version": "1.0.0",
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "action": {
    "default_icon": "icons/not-recording.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "sidePanel",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:43007/*",
    "http://127.0.0.1:43007/*"
  ]
}